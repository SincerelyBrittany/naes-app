# Stripe Configuration
# Get your Stripe Publishable Key from: https://dashboard.stripe.com/apikeys
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Get your Stripe Price ID from: https://dashboard.stripe.com/products
# Create a product and price for the signed book copy
VITE_PUBLIC_STRIPE_PRICE_ID=price_your_price_id_here

# EmailJS Configuration
# Get your EmailJS credentials from: https://www.emailjs.com/
# Template ID for purchase notifications
VITE_EMAIL_PURCHASE=your_email_template_id_here

# EmailJS Public Key (User ID)
VITE_EMAIL_AUTH=your_emailjs_public_key_here
