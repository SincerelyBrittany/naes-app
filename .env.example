# Copy values into .env / .env.production (never commit real secrets if the repo is public)

# Your live site URL — no trailing slash (used for SEO canonical, OG tags, sitemap)
VITE_SITE_URL=https://narenerussell.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Mailchimp — either set the full form action URL (preferred):
VITE_MAILCHIMP_URL=
# Or use audience pieces (server prefix is usually us1, us2, etc.):
VITE_MAILCHIMP_DC=us1
VITE_REACT_APP_MAILCHIMP_U=
VITE_REACT_APP_MAILCHIMP_ID_ONE=
VITE_REACT_APP_MAILCHIMP_ID_TWO=
